# ─────────────────────────────────────────────────────
# JetLearn Ops — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local or google-service-account.json
# ─────────────────────────────────────────────────────

# ── Google Service Account ────────────────────────────
# Base64-encoded service account JSON (preferred — use this on Vercel)
# Generate: base64 -w 0 google-service-account.json
# Windows:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("google-service-account.json"))
GOOGLE_SERVICE_ACCOUNT_B64=

# ── Google Sheets ─────────────────────────────────────
SHEET_ID_MIGRATION=1xzprj2U6NpJwoevBMvM1DVfIj76wVjAd0ZcMjVC1xMM
SHEET_ID_PERSONA=1rSweVyLKEwb1xThFHMLoH4xWnrLs8wbRM_61VtRjGww
SHEET_ID_AUDIT=1iNrejNX3HA01UqYEch94HuKLQCffSPofB8KbD4D9sI4

# ── Google Calendar ───────────────────────────────────
CLASS_SCHEDULE_CALENDAR_ID=

# ── HubSpot ───────────────────────────────────────────
HUBSPOT_API_KEY=

# ── WATI (WhatsApp) ───────────────────────────────────
WATI_API_ENDPOINT=
WATI_ACCESS_TOKEN=

# ── AI ────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Exchange Rate ─────────────────────────────────────
EXCHANGERATE_API_KEY=

# ── App ───────────────────────────────────────────────
APP_URL=http://localhost:3000
NODE_ENV=development
